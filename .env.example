# Скопируйте в .env и поменяйте значения: cp .env.example .env
POSTGRES_DB=donish
POSTGRES_USER=donish
POSTGRES_PASSWORD=change-me-postgres

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Первый администратор создаётся при запуске, если админов ещё нет.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

HTTP_PORT=8080
ADMIN_HTTP_PORT=8081
# Адреса, по которым сайт и админка ссылаются друг на друга (в проде — ваши домены).
SITE_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
